# Zig build files and sources are parsed by Zig, which expects LF. A CRLF
# checkout on a Windows runner would otherwise break `zig build` there while
# working on Linux.
build.zig text eol=lf
build.zig.zon text eol=lf
*.zig text eol=lf

# Anything we require to keep its bytes.
*.png binary
*.ppm binary

# Test fixtures are compared byte for byte (sizes, offsets, section text), so
# a Windows checkout must not rewrite their line endings. The parsers accept
# CRLF on their own; that is covered by unit tests, not by the fixtures.
test/fixtures/** text eol=lf
