.{
    .name = .conduit,
    .version = "0.0.0",
    .fingerprint = 0xfdbb528163fad0ac,
    // The pin that TASK-2 confirmed against the pinned Ghostty tree's own
    // `.minimum_zig_version`. Changing it is its own task and decision record.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Terminal engine, consumed as the Zig module `ghostty-vt`
        // (root `src/lib_vt.zig`). URL and multihash are the ones the TASK-2
        // spike verified; see backlog decision-1 and doc-1.
        .ghostty = .{
            .url = "https://github.com/ghostty-org/ghostty/archive/5dc28bb8eebaf57a6c793a406bfea8c632d4fa94.tar.gz",
            .hash = "ghostty-1.3.2-dev-5UdBC1TZeAVqaxNT2HwRRz7Zvl2JywwJ-XYOAa5yKQ7j",
        },
        // OpenGL 3.3 core bindings (GPU axis of backlog decision-2). Hash is the
        // one the TASK-3 spike built and ran with.
        .zopengl = .{
            .url = "https://github.com/zig-gamedev/zopengl/archive/refs/heads/master.tar.gz",
            .hash = "zopengl-0.6.0-dev-5-tnz8mnDgCHR72YtUpLBYW_u4JgZ0Ub-UFX-M0zRSG1",
        },
        // SDL3, for window and input (backlog decision-2). Provides the `SDL3`
        // library artifact; Conduit owns the thin extern seam over its headers.
        .sdl = .{
            .url = "https://github.com/castholm/SDL/archive/refs/tags/v0.5.4%2B3.4.16.tar.gz",
            .hash = "sdl-0.5.4+3.4.16-SDL--sQ4qAH3kwC19Zs1kxdHplaSDnWl2MUptZD4AItI",
        },

        // FreeType and HarfBuzz, vendored and pinned: the font manager
        // rasterises with the first and shapes with the second. Vendored
        // rather than taken from the system because
        // `.github/workflows/ci.yml` installs no system packages, and the
        // same build has to work on the Linux, macOS and Windows runners.
        // Both are the exact tarballs the pinned Ghostty tree builds (see
        // `pkg/freetype/build.zig` and `pkg/harfbuzz/build.zig` in it), so
        // Conduit and the terminal engine rasterise with one FreeType.
        // Licences: FreeType is dual FTL/GPL-2.0, HarfBuzz is the old MIT
        // licence; both texts are in `assets/THIRD-PARTY-LICENSES/`.
        .freetype = .{
            .url = "https://deps.files.ghostty.org/freetype-1220b81f6ecfb3fd222f76cf9106fecfa6554ab07ec7fdc4124b9bb063ae2adf969d.tar.gz",
            .hash = "N-V-__8AAKLKpwC4H27Ps_0iL3bPkQb-z6ZVSrB-x_3EEkub",
        },
        .harfbuzz = .{
            .url = "https://deps.files.ghostty.org/harfbuzz-11.0.0.tar.xz",
            .hash = "N-V-__8AAG02ugUcWec-Ndp-i7JTsJ0dgF8nnJRUInkGLG7G",
        },
        // Regex search uses the exact Oniguruma 6.9.9 source tarball and
        // content hash pinned by Ghostty's `pkg/oniguruma/build.zig.zon`.
        // Conduit builds it statically, so packaged binaries do not acquire a
        // distro-specific libonig runtime dependency.
        .oniguruma = .{
            .url = "https://deps.files.ghostty.org/oniguruma-1220c15e72eadd0d9085a8af134904d9a0f5dfcbed5f606ad60edc60ebeccd9706bb.tar.gz",
            .hash = "N-V-__8AAHjwMQDBXnLq3Q2QhaivE0kE2aD138vtX2Bq1g7c",
        },
    },
    .paths = .{
        "LICENSE",
        "assets",
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
